---
import { t, p, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const currentYear = new Date().getFullYear();
const homePath = p(locale === 'en' ? '/en' : '/');
---

<footer class="site-footer">
  <div class="container footer-container">
    <!-- Top Grid -->
    <div class="footer-top grid-12">
      <!-- Col 1: Brand & Concept -->
      <div class="footer-col brand-col">
        <a href={homePath} class="footer-logo" aria-label="Hotel Dann Carlton Cali">
          <img src={p('/scroll-logo.svg')} alt="Dann Carlton Cali" width="160" height="42" class="footer-logo-img" />
        </a>
        <p class="brand-tagline">
          {t(locale, 'footer.tagline')}
        </p>
        <p class="brand-subtext text-slate">
          {locale === 'en'
            ? 'A five-star haven uniting architectural elegance, Pacific culinary tradition, and world-class hospitality.'
            : 'Un oasis cinco estrellas que conjuga sobriedad arquitectónica, tradición culinaria del Pacífico y hospitalidad de clase mundial.'}
        </p>
      </div>

      <!-- Col 2: Direct Contact -->
      <div class="footer-col contact-col">
        <h4 class="col-title">{t(locale, 'footer.contact')}</h4>
        <ul class="contact-list text-slate">
          <li>
            <strong>{locale === 'en' ? 'Address:' : 'Dirección:'}</strong>
            <span>Carrera 2 # 1-60, El Peñón, Cali, Colombia</span>
          </li>
          <li>
            <strong>{locale === 'en' ? 'PBX Telephones:' : 'Teléfonos PBX:'}</strong>
            <a href="tel:+576028933000">+57 60 (2) 893 3000</a> / <a href="tel:+576028862000">886 2000</a>
          </li>
          <li>
            <strong>{locale === 'en' ? 'Direct Email:' : 'Correo Directo:'}</strong>
            <a href="mailto:reservas@hotelesdanncali.com.co">reservas@hotelesdanncali.com.co</a>
          </li>
          <li>
            <strong>{locale === 'en' ? 'Front Desk:' : 'Recepción:'}</strong>
            <span>{locale === 'en' ? '24 Hours / 365 Days' : 'Atención 24 horas, 365 días'}</span>
          </li>
        </ul>
      </div>

      <!-- Col 3: Navigation Links -->
      <div class="footer-col nav-col">
        <h4 class="col-title">{t(locale, 'footer.quick_links')}</h4>
        <ul class="footer-nav-list text-slate">
          <li><a href={p(locale === 'en' ? '/en/habitaciones' : '/habitaciones')}>{t(locale, 'nav.rooms')}</a></li>
          <li><a href={p(locale === 'en' ? '/en/amenidades' : '/amenidades')}>{t(locale, 'nav.amenities')}</a></li>
          <li><a href={p(locale === 'en' ? '/en/restaurantes' : '/restaurantes')}>{t(locale, 'nav.dining')}</a></li>
          <li><a href={p(locale === 'en' ? '/en/spa' : '/spa')}>{t(locale, 'nav.spa')}</a></li>
          <li><a href={p(locale === 'en' ? '/en/eventos' : '/eventos')}>{t(locale, 'nav.events')}</a></li>
          <li><a href={p(locale === 'en' ? '/en/ofertas' : '/ofertas')}>{t(locale, 'nav.offers')}</a></li>
          <li><a href={p(locale === 'en' ? '/en/contacto' : '/contacto')}>{t(locale, 'nav.contact')}</a></li>
        </ul>
      </div>
    </div>

    <!-- Legal Section in Details Tag -->
    <div class="footer-legal">
      <details class="legal-details">
        <summary class="legal-summary">
          <span>{t(locale, 'footer.legal_summary')}</span>
          <svg class="summary-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="legal-content text-slate">
          <p>{t(locale, 'footer.legal_text')}</p>
          <p class="mt-2">
            {locale === 'en'
              ? 'In accordance with Article 17 of Law 679 of 2001, Hotel Dann Carlton Cali warns that sexual exploitation and abuse of minors are penalized criminally and administratively according to Colombian law.'
              : 'En desarrollo de lo dispuesto en el artículo 17 de la Ley 679 de 2001, el Hotel Dann Carlton Cali advierte que la explotación y el abuso sexual de menores de edad en el país son sancionados conforme a las leyes penales y administrativas vigentes.'}
          </p>
        </div>
      </details>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright text-slate">
        &copy; {currentYear} {t(locale, 'footer.rights')}
      </p>
      <a 
        href={`https://reservations.travelclick.com/9878657?languageid=${locale === 'en' ? '1' : '2'}`}
        target="_blank"
        rel="noopener noreferrer"
        class="direct-guarantee-badge"
      >
        <span class="badge-dot"></span>
        {locale === 'en' ? 'Official Booking Engine (TravelClick)' : 'Motor Oficial de Reservas (TravelClick)'}
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--paper);
    color: var(--ink);
    border-top: 1px solid var(--stone);
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
    margin-top: auto;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .footer-top {
    row-gap: 2.5rem;
  }

  .brand-col {
    grid-column: span 12;
  }

  @media (min-width: 768px) {
    .brand-col {
      grid-column: span 5;
    }
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 1.25rem;
  }

  .footer-logo-img {
    height: 38px;
    width: auto;
  }

  .brand-tagline {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    margin-bottom: 0.75rem;
  }

  .brand-subtext {
    font-size: var(--text-sm);
    line-height: 1.65;
    max-width: 360px;
  }

  .contact-col {
    grid-column: span 12;
  }

  @media (min-width: 768px) {
    .contact-col {
      grid-column: span 4;
    }
  }

  .nav-col {
    grid-column: span 12;
  }

  @media (min-width: 768px) {
    .nav-col {
      grid-column: span 3;
    }
  }

  .col-title {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--brass);
    margin-bottom: 1.25rem;
  }

  .contact-list,
  .footer-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: var(--text-sm);
  }

  .contact-list strong {
    color: var(--ink);
    display: block;
    font-weight: 500;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.1rem;
  }

  .contact-list a:hover,
  .footer-nav-list a:hover {
    color: var(--ink);
  }

  /* Legal Accordion */
  .footer-legal {
    border-top: 1px solid var(--stone);
    border-bottom: 1px solid var(--stone);
    padding: 1rem 0;
  }

  .legal-details {
    cursor: pointer;
  }

  .legal-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--slate);
    list-style: none;
  }

  .legal-summary::-webkit-details-marker {
    display: none;
  }

  .summary-icon {
    transition: transform 0.25s ease;
  }

  .legal-details[open] .summary-icon {
    transform: rotate(180deg);
  }

  .legal-content {
    margin-top: 0.85rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    padding-top: 0.5rem;
  }

  .mt-2 {
    margin-top: 0.5rem;
  }

  /* Footer Bottom */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
    font-size: var(--text-xs);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .direct-guarantee-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--slate);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }

  .direct-guarantee-badge:hover {
    color: var(--ink);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10B981;
    display: inline-block;
  }
</style>
