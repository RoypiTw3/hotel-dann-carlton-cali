---
import type { Offer } from '../data/offers';
import { t, type Locale } from '../i18n/utils';

interface Props {
  offer: Offer;
  locale: Locale;
}

const { offer, locale } = Astro.props;

const formatCOP = (num: number) => {
  return new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: 'COP',
    maximumFractionDigits: 0
  }).format(num);
};

const bookingUrl = `https://reservations.travelclick.com/9878657?languageid=${locale === 'en' ? '1' : '2'}&RatePlanId=${offer.ratePlanId}`;
---

<article class="offer-card">
  <div class="offer-image-wrap">
    <img src={offer.image} alt={offer.name[locale]} class="offer-photo" loading="lazy" />
  </div>
  <div class="offer-body">
    <h3 class="offer-title">{offer.name[locale]}</h3>
    <p class="offer-desc text-slate">{offer.description[locale]}</p>

    <div class="offer-includes">
      <span class="includes-label">{t(locale, 'offers_page.includes')}</span>
      <ul class="includes-list text-slate">
        {offer.highlights[locale].map((item) => (
          <li>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="offer-footer">
      <div class="offer-price">
        <span class="price-prefix">{t(locale, 'offers_page.from_price')}</span>
        <span class="price-amount font-serif">{formatCOP(offer.priceCOP)}</span>
      </div>

      <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary offer-btn">
        <span>{t(locale, 'offers_page.book_offer')}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .offer-card {
    background-color: var(--paper);
    border: 1px solid var(--stone);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .offer-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.06);
  }

  .offer-image-wrap {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    position: relative;
    background-color: var(--stone);
  }

  .offer-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .offer-card:hover .offer-photo {
    transform: scale(1.03);
  }

  .offer-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1rem;
  }

  .offer-title {
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .offer-desc {
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .offer-includes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .includes-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brass);
  }

  .includes-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: var(--text-xs);
  }

  .includes-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .includes-list svg {
    color: var(--brass);
    margin-top: 2px;
    flex-shrink: 0;
  }

  .offer-footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--stone);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .offer-price {
    display: flex;
    flex-direction: column;
  }

  .price-prefix {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--slate);
  }

  .price-amount {
    font-size: 1.35rem;
    color: var(--ink);
  }

  .offer-btn {
    padding: 0.6rem 1.15rem;
    font-size: var(--text-xs);
  }
</style>
