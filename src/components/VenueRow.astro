---
import type { Venue } from '../data/venues';
import type { Locale } from '../i18n/utils';

interface Props {
  venue: Venue;
  locale: Locale;
}

const { venue, locale } = Astro.props;
---

<div class="venue-row">
  <div class="venue-thumb-col">
    <img src={venue.image} alt={venue.name} class="venue-thumb" loading="lazy" />
  </div>
  <div class="venue-main-col">
    <div class="venue-meta">
      <span class="meta-tag">{venue.tower[locale]}</span>
      <span class="meta-dot">·</span>
      <span class="meta-tag">{venue.floor[locale]}</span>
    </div>
    <h3 class="venue-name">{venue.name}</h3>
    <p class="venue-use text-slate">{venue.use[locale]}</p>
  </div>
  <div class="venue-specs-col">
    <div class="spec-block">
      <span class="spec-label">{locale === 'en' ? 'Area' : 'Área'}</span>
      <span class="spec-val font-serif">{venue.area}</span>
    </div>
    <div class="spec-block">
      <span class="spec-label">{locale === 'en' ? 'Max Capacity' : 'Capacidad Máx.'}</span>
      <span class="spec-val font-serif">{venue.capacity} <small>{locale === 'en' ? 'guests' : 'personas'}</small></span>
    </div>
  </div>
</div>

<style>
  .venue-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--stone);
  }

  @media (min-width: 768px) {
    .venue-row {
      grid-template-columns: 140px 1fr 220px;
      gap: 2rem;
    }
  }

  .venue-thumb-col {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--stone);
  }

  .venue-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .venue-main-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .venue-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    color: var(--brass);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .venue-name {
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .venue-use {
    font-size: var(--text-xs);
    line-height: 1.6;
    max-width: 540px;
  }

  .venue-specs-col {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    justify-content: flex-start;
  }

  @media (min-width: 768px) {
    .venue-specs-col {
      justify-content: flex-end;
    }
  }

  .spec-block {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .spec-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--slate);
    font-weight: 600;
  }

  .spec-val {
    font-size: 1.25rem;
    color: var(--ink);
  }

  .spec-val small {
    font-size: 0.75rem;
    font-family: var(--font-sans);
    color: var(--slate);
  }
</style>
