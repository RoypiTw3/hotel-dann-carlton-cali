---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localizedPath, p, type Locale } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  image?: string;
}

const { 
  title, 
  description, 
  locale, 
  image = '/img/fachada.jpg' 
} = Astro.props;

const pathname = Astro.url.pathname;
const siteOrigin = Astro.site ? Astro.site.origin : 'https://roypitw3.github.io';
const canonicalUrl = new URL(pathname, siteOrigin).href;
const esUrl = new URL(localizedPath(pathname, 'es'), siteOrigin).href;
const enUrl = new URL(localizedPath(pathname, 'en'), siteOrigin).href;

const hotelSchema = {
  "@context": "https://schema.org",
  "@type": "Hotel",
  "name": "Hotel Dann Carlton Cali",
  "description": description,
  "url": siteOrigin,
  "telephone": "+57 60 2 893 3000",
  "email": "reservas@hotelesdanncali.com.co",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Carrera 2 # 1-60",
    "addressLocality": "Cali",
    "addressRegion": "Valle del Cauca",
    "postalCode": "760004",
    "addressCountry": "CO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 3.45004,
    "longitude": -76.54053
  },
  "starRating": {
    "@type": "Rating",
    "ratingValue": "5"
  },
  "priceRange": "$$$",
  "checkinTime": "15:00",
  "checkoutTime": "13:00"
};
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Hotel Dann Carlton Cali</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Canonical and Hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Hotel Dann Carlton Cali" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Hotel Dann Carlton Cali`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:image" content={new URL(p(image), siteOrigin).href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={p("/favicon.svg")} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(hotelSchema)} />
  </head>
  <body>
    <Header locale={locale} currentPath={pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
