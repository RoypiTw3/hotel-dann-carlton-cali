---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Cta from '../components/Cta.astro';
import { amenities } from '../data/amenities';
import { t, p, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base 
  title={t(locale, 'amenities_page.hero_title')} 
  description={t(locale, 'amenities_page.hero_sub')}
  locale={locale}
  image="/img/piscina.jpg"
>
  <Hero 
    tag={locale === 'en' ? 'Wellness & Comfort' : 'Bienestar & Confort'}
    title={t(locale, 'amenities_page.hero_title')}
    subtitle={t(locale, 'amenities_page.hero_sub')}
    image="/img/piscina.jpg"
  />

  <section class="section amenities-grid-section">
    <div class="container">
      <SectionIntro 
        tag={locale === 'en' ? 'Comprehensive Facilities' : 'Instalaciones Integrales'}
        title={locale === 'en' ? 'Every Comfort Anticipated' : 'Cada Detalle Pensado para su Bienestar'}
        desc={locale === 'en'
          ? 'From our heated outdoor pool with mountain horizons to round-the-clock bespoke services.'
          : 'Desde nuestra piscina climatizada al aire libre hasta servicios personalizados las 24 horas.'}
      />

      <div class="amenities-list">
        {amenities.map((item, index) => (
          <article class={`amenity-card ${index % 2 !== 0 ? 'is-reversed' : ''}`}>
            <div class="amenity-img-col">
              <div class="amenity-img-wrap">
                <img src={p(item.image)} alt={item.name[locale]} class="amenity-img" loading="lazy" />
                <span class="amenity-floor-badge">{item.floor[locale]}</span>
              </div>
            </div>
            <div class="amenity-info-col">
              <div class="amenity-header">
                <div class="amenity-hours-badge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span>{item.hours[locale]}</span>
                </div>
                <h3 class="amenity-title font-serif">{item.name[locale]}</h3>
              </div>

              <p class="amenity-desc text-slate">{item.description[locale]}</p>

              <div class="amenity-features-box">
                <h4 class="features-label">{t(locale, 'amenities_page.highlights')}</h4>
                <ul class="features-list text-slate">
                  {item.features[locale].map((feat) => (
                    <li>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Cta locale={locale} />
</Base>

<style>
  .amenities-grid-section {
    background-color: var(--paper);
  }

  .amenities-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .amenity-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--stone);
  }

  @media (min-width: 992px) {
    .amenity-card {
      grid-template-columns: 6fr 6fr;
      gap: 4rem;
    }

    .amenity-card.is-reversed .amenity-img-col {
      order: 2;
    }

    .amenity-card.is-reversed .amenity-info-col {
      order: 1;
    }
  }

  .amenity-img-wrap {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background-color: var(--stone);
  }

  .amenity-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .amenity-card:hover .amenity-img {
    transform: scale(1.02);
  }

  .amenity-floor-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: rgba(14, 30, 58, 0.88);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .amenity-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .amenity-hours-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--brass);
    margin-bottom: 0.35rem;
  }

  .amenity-title {
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .amenity-desc {
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .amenity-features-box {
    background-color: rgba(230, 227, 220, 0.25);
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--stone);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .features-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brass);
  }

  .features-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    font-size: var(--text-xs);
  }

  @media (min-width: 640px) {
    .features-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .features-list li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .features-list svg {
    color: var(--brass);
    flex-shrink: 0;
  }
</style>
