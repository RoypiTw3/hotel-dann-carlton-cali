<script>
  function setupBookingEngine() {
    const checkinInput = document.getElementById('engine-checkin') as HTMLInputElement;
    const checkoutInput = document.getElementById('engine-checkout') as HTMLInputElement;
    const adultsSelect = document.getElementById('engine-adults') as HTMLSelectElement;
    const nightsText = document.getElementById('nights-count-text');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const roomCards = document.querySelectorAll('.room-booking-card') as NodeListOf<HTMLElement>;
    const selectPlanBtns = document.querySelectorAll('.select-plan-btn');

    // Drawer elements
    const drawerBackdrop = document.getElementById('booking-drawer');
    const closeDrawerBtn = document.getElementById('close-drawer-btn');
    const formView = document.getElementById('drawer-form-view');
    const successView = document.getElementById('drawer-success-view');
    const guestForm = document.getElementById('confirm-reservation-form') as HTMLFormElement;

    // Summary Elements
    const summaryRoomImg = document.getElementById('summary-room-img') as HTMLImageElement;
    const summaryRoomTower = document.getElementById('summary-room-tower');
    const summaryRoomName = document.getElementById('summary-room-name');
    const summaryPlanName = document.getElementById('summary-plan-name');
    const summaryCheckin = document.getElementById('summary-checkin-val');
    const summaryCheckout = document.getElementById('summary-checkout-val');
    const summaryNights = document.getElementById('summary-nights-val');
    const summaryGuests = document.getElementById('summary-guests-val');
    const summaryNightly = document.getElementById('summary-nightly-val');
    const summaryTotal = document.getElementById('summary-total-val');

    // Success Elements
    const confRoomName = document.getElementById('confirmed-room-name');
    const confVoucherCode = document.getElementById('confirmed-voucher-code');
    const confGuestName = document.getElementById('confirmed-guest-name');
    const confStayDates = document.getElementById('confirmed-stay-dates');
    const confPlanName = document.getElementById('confirmed-plan-name');
    const confTotalPrice = document.getElementById('confirmed-total-price');
    const whatsappLink = document.getElementById('whatsapp-confirm-link') as HTMLAnchorElement;
    const printBtn = document.getElementById('print-voucher-btn');

    // Selected state
    let activeRoomSlug = '';
    let activeRoomName = '';
    let activeRoomTower = '';
    let activeRoomImage = '';
    let activePlanType = 'flexible';
    let activePlanName = 'Tarifa Flexible con Desayuno';
    let activeNightlyRate = 0;
    let nightsCount = 1;

    // Currency Formatter
    const formatCOP = (num: number) => {
      return new Intl.NumberFormat('es-CO', {
        style: 'currency',
        currency: 'COP',
        maximumFractionDigits: 0
      }).format(num);
    };

    // Format Date helper
    const formatDateStr = (d: Date) => d.toISOString().split('T')[0];

    // Read query params if any
    const urlParams = new URLSearchParams(window.location.search);
    const queryCheckin = urlParams.get('checkin') || urlParams.get('DateIn');
    const queryCheckout = urlParams.get('checkout') || urlParams.get('DateOut');
    const queryAdults = urlParams.get('adults') || urlParams.get('Adults');
    const queryRoom = urlParams.get('room');
    const queryPlan = urlParams.get('plan');

    // Init dates
    const today = new Date();
    const defaultIn = new Date(today);
    defaultIn.setDate(today.getDate() + 1);
    const defaultOut = new Date(today);
    defaultOut.setDate(today.getDate() + 3);

    if (checkinInput) {
      checkinInput.min = formatDateStr(today);
      checkinInput.value = queryCheckin || formatDateStr(defaultIn);
    }
    if (checkoutInput) {
      checkoutInput.min = checkinInput ? checkinInput.value : formatDateStr(defaultIn);
      checkoutInput.value = queryCheckout || formatDateStr(defaultOut);
    }
    if (adultsSelect && queryAdults) {
      adultsSelect.value = queryAdults;
    }

    // Calculate nights & update all price cards
    const updateCalculations = () => {
      if (!checkinInput || !checkoutInput) return;

      const inDate = new Date(checkinInput.value);
      const outDate = new Date(checkoutInput.value);

      if (outDate <= inDate) {
        const next = new Date(inDate);
        next.setDate(next.getDate() + 1);
        checkoutInput.value = formatDateStr(next);
      }
      checkoutInput.min = checkinInput.value;

      const diffTime = Math.abs(new Date(checkoutInput.value).getTime() - new Date(checkinInput.value).getTime());
      nightsCount = Math.max(1, Math.ceil(diffTime / (1000 * 60 * 60 * 24)));

      if (nightsText) {
        nightsText.textContent = `${nightsCount} ${nightsCount === 1 ? 'noche' : 'noches'}`;
      }

      // Update room cards total price tags
      const totalElements = document.querySelectorAll('.total-rate-hint') as NodeListOf<HTMLElement>;
      totalElements.forEach(el => {
        const base = Number(el.getAttribute('data-base')) || 0;
        const total = base * nightsCount;
        const valSpan = el.querySelector('.total-dyn-val');
        if (valSpan) {
          valSpan.textContent = formatCOP(total);
        }
      });
    };

    checkinInput?.addEventListener('change', updateCalculations);
    checkoutInput?.addEventListener('change', updateCalculations);
    adultsSelect?.addEventListener('change', updateCalculations);
    updateCalculations();

    // Tower Filters
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const selectedTower = btn.getAttribute('data-tower');

        roomCards.forEach(card => {
          const cardTower = card.getAttribute('data-tower') || '';
          if (selectedTower === 'all' || cardTower.includes(selectedTower || '')) {
            card.style.display = 'grid';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Handle room selection & drawer open
    const openDrawer = (roomCard: HTMLElement, planType: string, planName: string, nightlyRate: number) => {
      activeRoomSlug = roomCard.getAttribute('data-slug') || '';
      activeRoomName = roomCard.getAttribute('data-room-name') || '';
      activeRoomTower = roomCard.getAttribute('data-tower') || '';
      activeRoomImage = roomCard.getAttribute('data-room-image') || '';
      activePlanType = planType;
      activePlanName = planName;
      activeNightlyRate = nightlyRate;

      // Populate summary
      if (summaryRoomImg) summaryRoomImg.src = activeRoomImage;
      if (summaryRoomTower) summaryRoomTower.textContent = activeRoomTower;
      if (summaryRoomName) summaryRoomName.textContent = activeRoomName;
      if (summaryPlanName) summaryPlanName.textContent = activePlanName;
      if (summaryCheckin) summaryCheckin.textContent = checkinInput ? checkinInput.value : '';
      if (summaryCheckout) summaryCheckout.textContent = checkoutInput ? checkoutInput.value : '';
      if (summaryNights) summaryNights.textContent = `${nightsCount} ${nightsCount === 1 ? 'noche' : 'noches'}`;
      if (summaryGuests) summaryGuests.textContent = `${adultsSelect ? adultsSelect.value : 2} Huéspedes`;
      if (summaryNightly) summaryNightly.textContent = formatCOP(activeNightlyRate);
      if (summaryTotal) summaryTotal.textContent = formatCOP(activeNightlyRate * nightsCount);

      // Show form view, hide success view
      if (formView) formView.style.display = 'block';
      if (successView) successView.style.display = 'none';

      // Reset drawer header
      const drawerStepTag = document.getElementById('drawer-step-tag');
      const drawerTitle = document.getElementById('drawer-title');
      const drawerPanel = document.querySelector('.booking-drawer-panel');
      if (drawerStepTag) drawerStepTag.textContent = drawerStepTag.getAttribute('data-orig') || '';
      if (drawerTitle) drawerTitle.textContent = drawerTitle.getAttribute('data-orig') || '';
      if (drawerPanel) drawerPanel.scrollTop = 0;

      // Open drawer
      if (drawerBackdrop) {
        drawerBackdrop.classList.add('is-open');
        drawerBackdrop.setAttribute('aria-hidden', 'false');
      }
    };

    const closeDrawer = () => {
      if (drawerBackdrop) {
        drawerBackdrop.classList.remove('is-open');
        drawerBackdrop.setAttribute('aria-hidden', 'true');
      }
    };

    closeDrawerBtn?.addEventListener('click', closeDrawer);
    drawerBackdrop?.addEventListener('click', (e) => {
      if (e.target === drawerBackdrop) closeDrawer();
    });

    selectPlanBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-room-slug');
        const planType = btn.getAttribute('data-plan-type') || 'flexible';
        const planName = btn.getAttribute('data-plan-name') || '';
        const nightlyRate = Number(btn.getAttribute('data-nightly')) || 0;
        const roomCard = document.getElementById(`room-card-${slug}`);
        if (roomCard) {
          openDrawer(roomCard, planType, planName, nightlyRate);
        }
      });
    });

    // Form submission
    guestForm?.addEventListener('submit', (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('guest-name') as HTMLInputElement;
      const emailInput = document.getElementById('guest-email') as HTMLInputElement;
      const phoneInput = document.getElementById('guest-phone') as HTMLInputElement;
      const idInput = document.getElementById('guest-id') as HTMLInputElement;
      const notesInput = document.getElementById('guest-notes') as HTMLTextAreaElement;

      // Generate reference code
      const randomCode = Math.floor(1000 + Math.random() * 9000);
      const voucherCode = `DC-CALI-2026-${randomCode}`;
      const totalPriceCOP = formatCOP(activeNightlyRate * nightsCount);

      // Populate success screen
      if (confRoomName) confRoomName.textContent = activeRoomName;
      if (confVoucherCode) confVoucherCode.textContent = voucherCode;
      if (confGuestName) confGuestName.textContent = nameInput ? nameInput.value : '';
      if (confStayDates) confStayDates.textContent = `${checkinInput?.value} al ${checkoutInput?.value} (${nightsCount} ${nightsCount === 1 ? 'noche' : 'noches'})`;
      if (confPlanName) confPlanName.textContent = activePlanName;
      if (confTotalPrice) confTotalPrice.textContent = totalPriceCOP;

      // Update drawer header for confirmation
      const drawerStepTag = document.getElementById('drawer-step-tag');
      const drawerTitle = document.getElementById('drawer-title');
      const drawerPanel = document.querySelector('.booking-drawer-panel');
      if (drawerStepTag) drawerStepTag.textContent = drawerStepTag.getAttribute('data-orig-success') || '¡Reserva Confirmada!';
      if (drawerTitle) drawerTitle.textContent = drawerTitle.getAttribute('data-orig-voucher') || 'Comprobante de Estadía';

      // WhatsApp link preparation
      const waMsg = encodeURIComponent(
        `Hola Hotel Dann Carlton Cali. He confirmado mi reserva directa.\n\n` +
        `• Código: ${voucherCode}\n` +
        `• Huésped: ${nameInput?.value}\n` +
        `• Documento: ${idInput?.value}\n` +
        `• Habitación: ${activeRoomName} (${activeRoomTower})\n` +
        `• Plan: ${activePlanName}\n` +
        `• Fechas: ${checkinInput?.value} al ${checkoutInput?.value} (${nightsCount} noches)\n` +
        `• Huéspedes: ${adultsSelect?.value}\n` +
        `• Total: ${totalPriceCOP}\n` +
        (notesInput?.value ? `• Solicitudes: ${notesInput.value}\n` : '') +
        `\nPor favor confirmar recibido de mi estadía.`
      );

      if (whatsappLink) {
        whatsappLink.href = `https://wa.me/573108933000?text=${waMsg}`;
      }

      // Switch views and scroll to top of panel
      if (formView) formView.style.display = 'none';
      if (successView) successView.style.display = 'flex';
      if (drawerPanel) drawerPanel.scrollTop = 0;
    });

    // Print button
    printBtn?.addEventListener('click', () => {
      window.print();
    });

    // If query room was passed in URL, scroll to it smoothly and open if requested
    if (queryRoom) {
      const targetCard = document.getElementById(`room-card-${queryRoom}`);
      if (targetCard) {
        setTimeout(() => {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetCard.style.outline = '2px solid var(--brass)';
        }, 300);
      }
    }
  }

  document.addEventListener('DOMContentLoaded', setupBookingEngine);
</script>
