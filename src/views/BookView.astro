---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { rooms } from '../data/rooms';
import { t, p, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Formatting helper
const formatCOP = (num: number) => {
  return new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: 'COP',
    maximumFractionDigits: 0
  }).format(num);
};
---

<Base 
  title={t(locale, 'booking_page.hero_title')} 
  description={t(locale, 'booking_page.hero_sub')}
  locale={locale}
  image="/img/fachada.jpg"
>
  <!-- Hero Section -->
  <Hero 
    tag={t(locale, 'booking_page.hero_tag')}
    title={t(locale, 'booking_page.hero_title')}
    subtitle={t(locale, 'booking_page.hero_sub')}
    image="/img/fachada.jpg"
  />

  <section class="booking-engine-section" id="booking-engine">
    <div class="container">
      
      <!-- Top Trust Guarantee Strip -->
      <div class="booking-guarantees-strip">
        <div class="guarantee-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <div>
            <strong>{locale === 'en' ? 'Direct Rate Guarantee' : 'Mejor Tarifa Garantizada'}</strong>
            <p>{locale === 'en' ? 'No intermediary commissions' : 'Sin comisiones intermedias'}</p>
          </div>
        </div>
        <div class="guarantee-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <div>
            <strong>{locale === 'en' ? 'Flexible Cancellation' : 'Cancelación Flexible'}</strong>
            <p>{locale === 'en' ? 'Up to 24h before arrival' : 'Hasta 24 horas antes'}</p>
          </div>
        </div>
        <div class="guarantee-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
            <line x1="6" y1="1" x2="6" y2="4"></line>
            <line x1="10" y1="1" x2="10" y2="4"></line>
            <line x1="14" y1="1" x2="14" y2="4"></line>
          </svg>
          <div>
            <strong>{locale === 'en' ? 'Buffet Breakfast & Wet Areas' : 'Desayuno Buffet & Zonas Húmedas'}</strong>
            <p>{locale === 'en' ? 'Included in your reservation' : 'Incluido en su reserva directa'}</p>
          </div>
        </div>
        <div class="guarantee-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <div>
            <strong>{locale === 'en' ? 'Direct 24/7 Concierge' : 'Atención Inmediata 24/7'}</strong>
            <p>{locale === 'en' ? 'Personalized WhatsApp assistance' : 'WhatsApp oficial con recepción'}</p>
          </div>
        </div>
      </div>

      <!-- Control Bar: Dates, Guests & Filters -->
      <div class="booking-control-card">
        <div class="control-grid">
          <!-- Check-in -->
          <div class="control-group">
            <label for="engine-checkin" class="control-label">{t(locale, 'booking.checkin')}</label>
            <input type="date" id="engine-checkin" class="control-input" />
          </div>

          <!-- Check-out -->
          <div class="control-group">
            <label for="engine-checkout" class="control-label">{t(locale, 'booking.checkout')}</label>
            <input type="date" id="engine-checkout" class="control-input" />
          </div>

          <!-- Duration Pill -->
          <div class="control-group duration-pill-group">
            <span class="control-label">{locale === 'en' ? 'Duration' : 'Duración'}</span>
            <div class="duration-display">
              <span id="nights-count-text">1 noche</span>
            </div>
          </div>

          <!-- Guests -->
          <div class="control-group">
            <label for="engine-adults" class="control-label">{t(locale, 'booking.guests')}</label>
            <select id="engine-adults" class="control-select">
              <option value="1">{t(locale, 'booking.guest_single')}</option>
              <option value="2" selected>{t(locale, 'booking.guest_double')}</option>
              <option value="3">{t(locale, 'booking.guest_multiple', { count: 3 })}</option>
              <option value="4">{t(locale, 'booking.guest_multiple', { count: 4 })}</option>
            </select>
          </div>
        </div>

        <!-- Tower Filter Pills -->
        <div class="tower-filters-row">
          <span class="filter-caption">{locale === 'en' ? 'Filter by Tower:' : 'Filtrar por Torre:'}</span>
          <div class="filter-buttons">
            <button type="button" class="filter-btn active" data-tower="all">
              {t(locale, 'booking_page.filter_all')}
            </button>
            <button type="button" class="filter-btn" data-tower="Torre Carlton">
              {t(locale, 'booking_page.filter_carlton')} (5★)
            </button>
            <button type="button" class="filter-btn" data-tower="Torre Dann Cali">
              {t(locale, 'booking_page.filter_dann')} (4★ Sup)
            </button>
          </div>
        </div>
      </div>

      <!-- Room Selection Grid -->
      <div class="rooms-inventory-list" id="rooms-list">
        {rooms.map((room) => {
          const nonRefPrice = Math.round(room.priceCOP * 0.90);
          return (
            <div 
              class="room-booking-card" 
              data-slug={room.slug}
              data-tower={room.tower.es}
              data-base-price={room.priceCOP}
              data-nonref-price={nonRefPrice}
              data-room-name={room.name[locale]}
              data-room-image={p(room.image)}
              id={`room-card-${room.slug}`}
            >
              <!-- Image Col -->
              <div class="room-media-box">
                <img 
                  src={p(room.image)} 
                  alt={room.name[locale]} 
                  class="room-engine-photo" 
                  loading="lazy" 
                />
                <span class="room-tower-tag">{room.tower[locale]}</span>
              </div>

              <!-- Main Info Col -->
              <div class="room-main-info">
                <div class="room-title-strip">
                  <h3 class="room-title-name font-serif">{room.name[locale]}</h3>
                  <div class="room-specs-pills">
                    <span class="spec-pill">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M2 4v16M2 8h18a2 2 0 0 1 2 2v10M2 17h20M6 8v9"></path>
                      </svg>
                      {room.bed[locale]}
                    </span>
                    <span class="spec-pill">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                      </svg>
                      {room.capacity[locale]}
                    </span>
                    <span class="spec-pill">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      </svg>
                      {room.area}
                    </span>
                  </div>
                </div>

                <p class="room-summary-text text-slate">{room.description[locale]}</p>

                <!-- Features Bullets -->
                <ul class="room-perks-bullets text-slate">
                  {room.features[locale].map((feat) => (
                    <li>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>

                <!-- Rate Options -->
                <div class="room-rates-options">
                  
                  <!-- Option 1: Flexible Rate -->
                  <div class="rate-option-card is-recommended">
                    <div class="rate-badge-popular">{locale === 'en' ? 'Most Popular' : 'Más Elegida'}</div>
                    <div class="rate-header">
                      <h4 class="rate-name">{t(locale, 'booking_page.plan_flexible')}</h4>
                      <p class="rate-sub">{t(locale, 'booking_page.plan_flexible_desc')}</p>
                    </div>
                    <div class="rate-pricing">
                      <div class="nightly-rate">
                        <span class="price-val font-serif">{formatCOP(room.priceCOP)}</span>
                        <span class="price-term">/ {t(locale, 'booking_page.night')}</span>
                      </div>
                      <div class="total-rate-hint" data-plan="flexible" data-base={room.priceCOP}>
                        {t(locale, 'booking_page.total_stay')}: <strong class="total-dyn-val">{formatCOP(room.priceCOP)}</strong>
                      </div>
                    </div>
                    <button 
                      type="button" 
                      class="btn btn-primary select-plan-btn"
                      data-room-slug={room.slug}
                      data-plan-type="flexible"
                      data-plan-name={t(locale, 'booking_page.plan_flexible')}
                      data-nightly={room.priceCOP}
                    >
                      <span>{t(locale, 'booking_page.select_room')}</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </button>
                  </div>

                  <!-- Option 2: Non-Refundable Rate (-10%) -->
                  <div class="rate-option-card">
                    <div class="rate-discount-tag">-10% Directo</div>
                    <div class="rate-header">
                      <h4 class="rate-name">{t(locale, 'booking_page.plan_nonref')}</h4>
                      <p class="rate-sub">{t(locale, 'booking_page.plan_nonref_desc')}</p>
                    </div>
                    <div class="rate-pricing">
                      <div class="nightly-rate">
                        <span class="price-val font-serif">{formatCOP(nonRefPrice)}</span>
                        <span class="price-term">/ {t(locale, 'booking_page.night')}</span>
                      </div>
                      <div class="total-rate-hint" data-plan="nonref" data-base={nonRefPrice}>
                        {t(locale, 'booking_page.total_stay')}: <strong class="total-dyn-val">{formatCOP(nonRefPrice)}</strong>
                      </div>
                    </div>
                    <button 
                      type="button" 
                      class="btn btn-outline select-plan-btn"
                      data-room-slug={room.slug}
                      data-plan-type="nonref"
                      data-plan-name={t(locale, 'booking_page.plan_nonref')}
                      data-nightly={nonRefPrice}
                    >
                      <span>{t(locale, 'booking_page.select_room')}</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </button>
                  </div>

                </div>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- Reservation Completion Drawer / Modal -->
  <div id="booking-drawer" class="booking-drawer-backdrop" aria-hidden="true">
    <div class="booking-drawer-panel" role="dialog" aria-modal="true">
      
      <!-- Drawer Header -->
      <div class="drawer-header">
        <div class="drawer-header-text">
          <span id="drawer-step-tag" class="drawer-step-tag" data-orig={t(locale, 'booking_page.step_guest')}>{t(locale, 'booking_page.step_guest')}</span>
          <h3 id="drawer-title" class="drawer-title font-serif" data-orig={t(locale, 'booking_page.guest_title')}>{t(locale, 'booking_page.guest_title')}</h3>
        </div>
        <button type="button" id="close-drawer-btn" class="drawer-close-btn" aria-label="Cerrar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Drawer Content: Steps or Form -->
      <div class="drawer-body">
        
        <!-- Form Mode -->
        <div id="drawer-form-view">
          
          <!-- Summary Card -->
          <div class="reservation-summary-card">
            <div class="summary-room-header">
              <img id="summary-room-img" src="/img/fachada.jpg" alt="Habitacion" class="summary-room-thumb" />
              <div class="summary-room-meta">
                <span id="summary-room-tower" class="summary-tower-tag">Torre Carlton</span>
                <h4 id="summary-room-name" class="summary-room-title">Suite Majestic</h4>
                <p id="summary-plan-name" class="summary-plan-title text-slate">Tarifa Flexible con Desayuno</p>
              </div>
            </div>

            <div class="summary-details-grid">
              <div class="summary-detail-item">
                <span class="detail-label">{locale === 'en' ? 'Check-in' : 'Llegada'}</span>
                <strong id="summary-checkin-val">2026-09-20</strong>
              </div>
              <div class="summary-detail-item">
                <span class="detail-label">{locale === 'en' ? 'Check-out' : 'Salida'}</span>
                <strong id="summary-checkout-val">2026-09-22</strong>
              </div>
              <div class="summary-detail-item">
                <span class="detail-label">{locale === 'en' ? 'Duration' : 'Estadía'}</span>
                <strong id="summary-nights-val">2 noches</strong>
              </div>
              <div class="summary-detail-item">
                <span class="detail-label">{locale === 'en' ? 'Guests' : 'Huéspedes'}</span>
                <strong id="summary-guests-val">2 Adultos</strong>
              </div>
            </div>

            <div class="summary-price-breakdown">
              <div class="price-row">
                <span class="text-slate">{locale === 'en' ? 'Nightly Average:' : 'Promedio por noche:'}</span>
                <span id="summary-nightly-val">$0</span>
              </div>
              <div class="price-row">
                <span class="text-slate">{locale === 'en' ? 'Taxes & Hotel Insurance:' : 'Impuestos & Seguro Hotelero:'}</span>
                <span class="badge-included">{locale === 'en' ? 'Included' : 'Incluidos'}</span>
              </div>
              <div class="price-row total-row">
                <strong>{locale === 'en' ? 'Total to Confirm:' : 'Total Estadía:'}</strong>
                <strong id="summary-total-val" class="font-serif summary-total-number">$0</strong>
              </div>
            </div>
          </div>

          <!-- Guest Input Form -->
          <form id="confirm-reservation-form" class="guest-inputs-form">
            <div class="form-group">
              <label for="guest-name" class="form-label">{t(locale, 'booking_page.guest_name')} *</label>
              <input type="text" id="guest-name" class="form-control" required placeholder="Ej. Carlos Mendoza" />
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label for="guest-email" class="form-label">{t(locale, 'booking_page.guest_email')} *</label>
                <input type="email" id="guest-email" class="form-control" required placeholder="carlos@empresa.com" />
              </div>
              <div class="form-group">
                <label for="guest-phone" class="form-label">{t(locale, 'booking_page.guest_phone')} *</label>
                <input type="tel" id="guest-phone" class="form-control" required placeholder="+57 300 123 4567" />
              </div>
            </div>

            <div class="form-group">
              <label for="guest-id" class="form-label">{t(locale, 'booking_page.guest_id')} *</label>
              <input type="text" id="guest-id" class="form-control" required placeholder="CC / Pasaporte" />
            </div>

            <div class="form-group">
              <label for="guest-notes" class="form-label">{t(locale, 'booking_page.guest_notes')}</label>
              <textarea id="guest-notes" class="form-control form-textarea" rows="2" placeholder={locale === 'en' ? 'Early check-in, high floor, anniversary setup...' : 'Llegada tardía, piso alto, decoración especial...'}></textarea>
            </div>

            <!-- Guarantee Notice -->
            <div class="direct-benefits-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <div>
                <strong>{t(locale, 'booking_page.guarantee_title')}</strong>
                <p class="text-slate">{t(locale, 'booking_page.guarantee_desc')}</p>
              </div>
            </div>

            <button type="submit" id="submit-booking-btn" class="btn btn-primary btn-submit-reservation">
              <span>{t(locale, 'booking_page.confirm_btn')}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </form>

        </div>

        <!-- Success Confirmation View -->
        <div id="drawer-success-view" class="drawer-success-view" style="display: none;">
          <div class="success-icon-wrap">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>

          <span class="success-tagline">{t(locale, 'booking_page.success_title')}</span>
          <h3 class="success-room-title font-serif" id="confirmed-room-name">Suite Majestic</h3>
          <p class="success-desc text-slate">{t(locale, 'booking_page.success_sub')}</p>

          <!-- Voucher Code Card -->
          <div class="voucher-box">
            <span class="voucher-label">{t(locale, 'booking_page.voucher_code')}</span>
            <span class="voucher-code font-serif" id="confirmed-voucher-code">DC-CALI-2026-9874</span>
          </div>

          <div class="confirmed-meta-list text-slate">
            <div>
              <span>{locale === 'en' ? 'Guest:' : 'Huésped:'}</span>
              <strong id="confirmed-guest-name">Carlos Mendoza</strong>
            </div>
            <div>
              <span>{locale === 'en' ? 'Stay Dates:' : 'Fechas:'}</span>
              <strong id="confirmed-stay-dates">2026-09-20 al 2026-09-22</strong>
            </div>
            <div>
              <span>{locale === 'en' ? 'Rate Plan:' : 'Plan:'}</span>
              <strong id="confirmed-plan-name">Tarifa Flexible</strong>
            </div>
            <div>
              <span>{locale === 'en' ? 'Total Guaranteed:' : 'Total Liquidado:'}</span>
              <strong id="confirmed-total-price" class="font-serif text-ink">$1.988.000 COP</strong>
            </div>
          </div>

          <!-- Actions -->
          <div class="success-actions">
            <a 
              id="whatsapp-confirm-link" 
              href="https://wa.me/573108933000" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-primary btn-whatsapp-confirm"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.52 3.48A11.93 11.93 0 0 0 12.04 0C5.46 0 .11 5.35.11 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.28-1.65a11.88 11.88 0 0 0 5.76 1.48h.01c6.58 0 11.93-5.35 11.93-11.93 0-3.19-1.24-6.19-3.46-8.42zM12.05 21.82a9.88 9.88 0 0 1-5.04-1.38l-.36-.21-3.73.98.99-3.64-.23-.37a9.89 9.89 0 0 1-1.52-5.27c0-5.46 4.45-9.91 9.91-9.91 2.65 0 5.13 1.03 7 2.91 1.88 1.88 2.91 4.36 2.91 7.01 0 5.46-4.44 9.91-9.93 9.91zm5.43-7.42c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.95 1.17-.17.2-.35.23-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.17.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.68-1.64-.93-2.25-.24-.59-.49-.51-.68-.52h-.58c-.2 0-.53.07-.8.38-.28.3-1.06 1.04-1.06 2.53s1.08 2.94 1.23 3.14c.15.2 2.13 3.25 5.16 4.56.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35z"/>
              </svg>
              <span>{t(locale, 'booking_page.whatsapp_btn')}</span>
            </a>

            <button type="button" id="print-voucher-btn" class="btn btn-outline">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
              <span>{t(locale, 'booking_page.print_btn')}</span>
            </button>

            <a href={p(locale === 'en' ? '/en' : '/')} class="link-arrow back-home-link">
              <span>{t(locale, 'booking_page.back_home')}</span>
              &rarr;
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>

</Base>

<style>
  .booking-engine-section {
    padding: 3.5rem 0 6rem;
    background-color: var(--paper);
  }

  /* Guarantees Strip */
  .booking-guarantees-strip {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
    padding: 1.5rem;
    background-color: rgba(230, 227, 220, 0.4);
    border: 1px solid var(--stone);
    border-radius: var(--radius-sm);
    margin-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .booking-guarantees-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .booking-guarantees-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .guarantee-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    color: var(--ink);
  }

  .guarantee-item svg {
    color: var(--brass);
