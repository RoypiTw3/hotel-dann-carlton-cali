---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import DiningFeature from '../components/DiningFeature.astro';
import Cta from '../components/Cta.astro';
import { diningVenues } from '../data/dining';
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base 
  title={t(locale, 'dining_page.hero_title')} 
  description={t(locale, 'dining_page.hero_sub')}
  locale={locale}
  image="/img/platos.jpg"
>
  <Hero 
    tag={locale === 'en' ? 'Haute Gastronomy' : 'Alta Gastronomía'}
    title={t(locale, 'dining_page.hero_title')}
    subtitle={t(locale, 'dining_page.hero_sub')}
    image="/img/platos.jpg"
  />

  <section class="section dining-list-section">
    <div class="container">
      <SectionIntro 
        tag={locale === 'en' ? 'Culinary Destinations' : 'Espacios Gastronómicos'}
        title={locale === 'en' ? 'Authentic Flavors, Elevated Settings' : 'Sabores Auténticos en Entornos Privilegiados'}
        desc={t(locale, 'dining_page.hero_sub')}
      />

      <div class="dining-features-wrap">
        {diningVenues.map((venue, idx) => (
          <DiningFeature venue={venue} locale={locale} reversed={idx % 2 !== 0} />
        ))}
      </div>

      <!-- Room Service 24h Feature Block -->
      <div class="room-service-card">
        <div class="rs-content">
          <span class="rs-badge">24 / 7</span>
          <h3 class="rs-title font-serif">{t(locale, 'dining_page.room_service_title')}</h3>
          <p class="rs-desc text-slate">{t(locale, 'dining_page.room_service_desc')}</p>
          <div class="rs-actions">
            <a href="tel:+576028933000" class="btn btn-primary">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>{locale === 'en' ? 'Call Concierge / Room Service' : 'Llamar a Room Service (Ext. 0)'}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Cta locale={locale} />
</Base>

<style>
  .dining-list-section {
    background-color: var(--paper);
  }

  .dining-features-wrap {
    display: flex;
    flex-direction: column;
  }

  .room-service-card {
    margin-top: 4rem;
    padding: 3.5rem 2.5rem;
    background-color: rgba(230, 227, 220, 0.35);
    border: 1px solid var(--stone);
    border-radius: var(--radius-sm);
    text-align: center;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  .rs-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .rs-badge {
    background-color: var(--brass);
    color: #FFFFFF;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }

  .rs-title {
    font-size: var(--text-lg);
  }

  .rs-desc {
    font-size: var(--text-sm);
    line-height: 1.7;
    max-width: 580px;
  }

  .rs-actions {
    margin-top: 0.75rem;
  }
</style>
