---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import VenueRow from '../components/VenueRow.astro';
import Cta from '../components/Cta.astro';
import { venues } from '../data/venues';
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base 
  title={t(locale, 'events_page.hero_title')} 
  description={t(locale, 'events_page.hero_sub')}
  locale={locale}
  image="/img/salon-ritz.jpg"
>
  <Hero 
    tag={locale === 'en' ? 'Conventions & Celebrations' : 'Convenciones & Celebraciones'}
    title={t(locale, 'events_page.hero_title')}
    subtitle={t(locale, 'events_page.hero_sub')}
    image="/img/salon-ritz.jpg"
  />

  <!-- Stats Grid -->
  <section class="events-stats-strip">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-num font-serif">1.872 <small>m²</small></span>
          <span class="stat-lbl">{t(locale, 'events_page.stats_area')}</span>
        </div>
        <div class="stat-card">
          <span class="stat-num font-serif">1.000</span>
          <span class="stat-lbl">{t(locale, 'events_page.stats_cap')}</span>
        </div>
        <div class="stat-card">
          <span class="stat-num font-serif">11</span>
          <span class="stat-lbl">{t(locale, 'events_page.stats_venues')}</span>
        </div>
        <div class="stat-card">
          <span class="stat-num font-serif">100%</span>
          <span class="stat-lbl">{t(locale, 'events_page.stats_tech')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Venues Table / List -->
  <section class="section venues-section">
    <div class="container">
      <SectionIntro 
        tag={locale === 'en' ? 'Floorplans & Specs' : 'Planos & Especificaciones'}
        title={t(locale, 'events_page.venues_table_title')}
        desc={locale === 'en' 
          ? 'Eleven versatile spaces engineered for corporate summits, hybrid seminars, social galas, and board meetings.'
          : 'Once salones versátiles acondicionados para cumbres empresariales, congresos híbridos, bodas de gala y reuniones de junta.'}
      />

      <div class="venues-list">
        {venues.map((venue) => (
          <VenueRow venue={venue} locale={locale} />
        ))}
      </div>

      <!-- RFP Proposal Form -->
      <div class="rfp-box">
        <div class="rfp-header">
          <p class="tagline">{locale === 'en' ? 'Tailored Proposals' : 'Cotizaciones Personalizadas'}</p>
          <h3 class="rfp-title font-serif">{t(locale, 'events_page.rfp_title')}</h3>
          <p class="rfp-desc text-slate">{t(locale, 'events_page.rfp_desc')}</p>
        </div>

        <form 
          action="mailto:reservas@hotelesdanncali.com.co" 
          method="GET" 
          class="rfp-form"
        >
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">{locale === 'en' ? 'Full Name' : 'Nombre Completo'}</label>
              <input type="text" name="name" required class="form-input" placeholder={locale === 'en' ? 'Your Name' : 'Su Nombre'} />
            </div>
            <div class="form-group">
              <label class="form-label">{locale === 'en' ? 'Company / Organization' : 'Empresa u Organización'}</label>
              <input type="text" name="company" class="form-input" placeholder={locale === 'en' ? 'Company Name' : 'Nombre de la Empresa'} />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">{locale === 'en' ? 'Email' : 'Correo Electrónico'}</label>
              <input type="email" name="email" required class="form-input" placeholder="correo@empresa.com" />
            </div>
            <div class="form-group">
              <label class="form-label">{locale === 'en' ? 'Phone Number' : 'Teléfono de Contacto'}</label>
              <input type="tel" name="phone" required class="form-input" placeholder="+57 ..." />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">{locale === 'en' ? 'Event Type' : 'Tipo de Evento'}</label>
              <select name="event_type" class="form-select">
                <option value="corporativo">{locale === 'en' ? 'Corporate Conference / Summit' : 'Congreso / Conferencia Corporativa'}</option>
                <option value="social">{locale === 'en' ? 'Wedding / Social Gala' : 'Boda / Evento Social'}</option>
                <option value="taller">{locale === 'en' ? 'Executive Workshop / Training' : 'Taller / Capacitación Ejecutiva'}</option>
                <option value="banquete">{locale === 'en' ? 'Private Banquet / Dinner' : 'Banquete Privado'}</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">{locale === 'en' ? 'Estimated Attendees' : 'Número Estimado de Asistentes'}</label>
              <input type="number" name="attendees" min="5" max="1000" class="form-input" placeholder="50" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">{locale === 'en' ? 'Event Details & Date' : 'Detalles del Evento y Fechas'}</label>
            <textarea name="body" rows="3" class="form-textarea" placeholder={locale === 'en' ? 'Indicate date, catering preferences, audiovisual requirements...' : 'Indique fecha tentativa, requerimientos audiovisuales, necesidades de catering...'}></textarea>
          </div>

          <button type="submit" class="btn btn-primary rfp-submit-btn">
            <span>{t(locale, 'events_page.rfp_btn')}</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>

  <Cta locale={locale} />
</Base>

<style>
  .events-stats-strip {
    background-color: rgba(230, 227, 220, 0.3);
    border-top: 1px solid var(--stone);
    border-bottom: 1px solid var(--stone);
    padding: 3rem 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-num {
    font-size: var(--text-xl);
    color: var(--ink);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-num small {
    font-size: var(--text-md);
    color: var(--brass);
    font-family: var(--font-sans);
  }

  .stat-lbl {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--slate);
  }

  .venues-section {
    background-color: var(--paper);
  }

  .venues-list {
    display: flex;
    flex-direction: column;
  }

  /* RFP Box */
  .rfp-box {
    margin-top: 5rem;
    padding: 3.5rem 2.5rem;
    background-color: rgba(230, 227, 220, 0.35);
    border: 1px solid var(--stone);
    border-radius: var(--radius-sm);
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  .rfp-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .rfp-title {
    font-size: var(--text-lg);
    margin-top: 0.35rem;
    margin-bottom: 0.5rem;
  }

  .rfp-desc {
    font-size: var(--text-sm);
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.65;
  }

  .rfp-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--slate);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    background-color: var(--paper);
    border: 1px solid var(--stone);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.85rem;
    font-size: var(--text-sm);
    color: var(--ink);
    font-family: var(--font-sans);
    transition: border-color 0.2s ease;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--brass);
  }

  .rfp-submit-btn {
    align-self: center;
    padding: 0.85rem 2.25rem;
    margin-top: 0.75rem;
  }
</style>
